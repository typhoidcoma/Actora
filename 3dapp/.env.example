# Same variables as the root app. Empty base URL = in-browser mock (no login).
VITE_AELORA_BASE_URL=
VITE_AELORA_MOCK=1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_AUTH_REDIRECT_URL=

# The character GLB to load. Defaults to /models/character.glb, then the placeholder.
VITE_CHARACTER_URL=
