# Actora on Cloud Run. ${PORT} is filled in at container start (envsubst);
# nginx's own variables ($uri…) are left alone because they aren't env vars.

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
  gzip_min_length 1024;

  # Hashed build output: cache forever.
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  # The push service worker and manifest must never be cached, and a missing
  # file must 404 rather than fall back to index.html (Aelora docs/PUSH.md §3).
  location = /sw.js {
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
    add_header Service-Worker-Allowed "/" always;
  }
  location = /manifest.webmanifest {
    try_files $uri =404;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache" always;
  }

  # Single-page app: every other path is the app shell, always revalidated.
  location / {
    try_files $uri $uri/ /index.html;
    # (add_header in a location replaces the server's, so these live here.)
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
  }
}
