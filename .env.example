# Aelora backend origin, no trailing slash. The WebSocket URL is derived from it (wss://<host>/ws).
# Leave empty to run fully offline against the in-browser mock.
VITE_AELORA_BASE_URL=

# 1 = use the in-browser mock backend (no login, seeded data, simulated Wendy).
VITE_AELORA_MOCK=1

# Optional: override the Supabase project instead of reading it from GET /api/public-config.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
